 "speeches": [
  {
   "date": "2026-07-09",
   "house": "参議院",
   "meeting": "厚生労働委員会",
   "speaker": "石田昌宏",
   "group": "自由民主党・無所属の会",
   "chars": 599,
   "excerpt": "○石田昌宏君 ありがとうございます。 情報提供は私は必要なことだというふうに思ってはいますけれども、その是非の問題と、そもそも不利益な取扱いがあるかどうかという問題、この二つ今重なってきていると思いますので、そこはやっぱり論点なり議論が複雑",
   "url": "https://kokkai.ndl.go.jp/txt/122114260X01720260709/8"
  },
  {
   "date": "2026-07-09",
   "house": "参議院",
   "meeting": "厚生労働委員会",
   "speaker": "黒田秀郎",
   "group": "政府・不明",
   "chars": 333,
   "excerpt": "○政府参考人（黒田秀郎君） お答え申し上げます。 今回のような事件を未然に防ぐためにも、ケアマネジャーの方々を含めた在宅介護従事者の安全確保は極めて重要でございます。 委員御指摘くださいましたように、令和七年度の補正予算で事業を計上しており",
   "url": "https://kokkai.ndl.go.jp/txt/122114260X01720260709/9"
  },
  {
   "date": "2026-07-09",
   "house": "参議院",
   "meeting": "厚生労働委員会",
   "speaker": "石田昌宏",
   "group": "自由民主党・無所属の会",
   "chars": 938,
   "excerpt": "○石田昌宏君 ありがとうございます。 予算の確保、私たちも一生懸命頑張っていきたいと思いますので、それは協力してやっていきたいと思いますし、委員の皆様にも是非一緒に予算確保を頑張っていただけたら有り難いと思います。 ただ、地域医療確保基金な",
   "url": "https://kokkai.ndl.go.jp/txt/122114260X01720260709/10"
  },
  {
   "date": "2026-07-09",
   "house": "参議院",
   "meeting": "厚生労働委員会",
   "speaker": "上野賢一郎",
   "group": "自由民主党・無所属の会",
   "chars": 400,
   "excerpt": "○国務大臣（上野賢一郎君） まず、訪問介護・看護においては、これまでも介護報酬上、利用者及びその家族の同意を得た上で複数名で訪問を行った場合の加算の算定を可能としております。また、ケアマネジャーも含めまして、今お話のありました地域医療介護総",
   "url": "https://kokkai.ndl.go.jp/txt/122114260X01720260709/11"
  },
  {
   "date": "2026-07-09",
   "house": "参議院",
   "meeting": "厚生労働委員会",
   "speaker": "石田昌宏",
   "group": "自由民主党・無所属の会",
   "chars": 218,
   "excerpt": "○石田昌宏君 予算上の対応を含めて検討していただくのは有り難いと思いますし、是非それも後押ししていきたいと思います。ただ、実態調査してから検討するって結構時間掛かるかもしれないので、これ多分命懸かっている話ですので、早急に取り組んでいただい",
   "url": "https://kokkai.ndl.go.jp/txt/122114260X01720260709/12"
  }
 ],
 "speechesTruncated": false
}