 "speeches": [
  {
   "date": "2026-07-09",
   "house": "参議院",
   "meeting": "農林水産委員会",
   "speaker": "横沢高徳",
   "group": "立憲民主・無所属",
   "chars": 190,
   "excerpt": "○横沢高徳君 おはようございます。立憲民主党の横沢高徳でございます。 本日も現場の声を基に質問させていただきます。どうぞよろしくお願いを申し上げます。 まずは、日本の地理的表示保護制度、ＧＩ制度について伺います。 二〇一五年からスタートした",
   "url": "https://kokkai.ndl.go.jp/txt/122115007X01420260709/24"
  },
  {
   "date": "2026-07-09",
   "house": "参議院",
   "meeting": "農林水産委員会",
   "speaker": "山下雄平",
   "group": "自由民主党・無所属の会",
   "chars": 520,
   "excerpt": "○副大臣（山下雄平君） お答えします。 地理的表示、ＧＩ保護制度は、地域ならではの環境で育まれた品質、社会的評価といった特性を有する産品の名称を知的財産として保護する制度でありまして、これまで、先ほど横沢委員が御指摘のありましたとおり、国内",
   "url": "https://kokkai.ndl.go.jp/txt/122115007X01420260709/25"
  },
  {
   "date": "2026-07-09",
   "house": "参議院",
   "meeting": "農林水産委員会",
   "speaker": "横沢高徳",
   "group": "立憲民主・無所属",
   "chars": 341,
   "excerpt": "○横沢高徳君 ありがとうございます。 そこで質問なんですが、登録制度導入から十一年目を迎えまして、生産者団体の置かれている状況にも変化が見られています。例えば、地元岩手県の前沢牛の生産地では、飼料の高騰などにより生産現場は厳しい状況が続いて",
   "url": "https://kokkai.ndl.go.jp/txt/122115007X01420260709/26"
  },
  {
   "date": "2026-07-09",
   "house": "参議院",
   "meeting": "農林水産委員会",
   "speaker": "杉中淳",
   "group": "政府・不明",
   "chars": 715,
   "excerpt": "○政府参考人（杉中淳君） お答えいたします。 まず、議員御指摘のあった前沢牛についてでございますけれども、元々奥州牛として生産していた地域についても前沢牛として生産、販売をしたいということで、生産者団体から、ＧＩに登録されている生産地を前沢",
   "url": "https://kokkai.ndl.go.jp/txt/122115007X01420260709/27"
  },
  {
   "date": "2026-07-09",
   "house": "参議院",
   "meeting": "農林水産委員会",
   "speaker": "横沢高徳",
   "group": "立憲民主・無所属",
   "chars": 183,
   "excerpt": "○横沢高徳君 まさにそのとおりでありますが、まず、法案の目的としても、生産者の利益を守り地域産業の発展に寄与すること、これが掲げられておりますので、その点も含んで、学識経験者の意見ももちろん大事ですが、本来の目的達成のために努力している現場",
   "url": "https://kokkai.ndl.go.jp/txt/122115007X01420260709/28"
  },
  {
   "date": "2026-07-09",
   "house": "参議院",
   "meeting": "農林水産委員会",
   "speaker": "鈴木憲和",
   "group": "自由民主党・無所属の会",
   "chars": 377,
   "excerpt": "○国務大臣（鈴木憲和君） このＧＩ、私の地元でも米沢牛があるんですけれども、済みません、私はすごい地元のことだと詳しいわけですけれども、やっぱりその歴史的背景とか、どういう作り方をするかとか、かなり厳格にそのエリアと生産者の生産する方法をで",
   "url": "https://kokkai.ndl.go.jp/txt/122115007X01420260709/29"
  }
 ],
