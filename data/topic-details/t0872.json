 "speeches": [
  {
   "date": "2026-07-14",
   "house": "参議院",
   "meeting": "厚生労働委員会",
   "speaker": "郡山りょう",
   "group": "立憲民主・無所属",
   "chars": 1112,
   "excerpt": "○郡山りょう君 ありがとうございます。 恐らく今だと監督官の皆さんも結構負荷的に厳しいところがあると思いますので、是非、すぐには確かに、大幅に倍になるとかということは私どもも求めていないですので、やはり応援していく立場としてもいろんな提言も",
   "url": "https://kokkai.ndl.go.jp/txt/122114260X01820260714/38"
  },
  {
   "date": "2026-07-14",
   "house": "参議院",
   "meeting": "厚生労働委員会",
   "speaker": "森光敬子",
   "group": "政府・不明",
   "chars": 313,
   "excerpt": "○政府参考人（森光敬子君） お答え申し上げます。 過去に実施いたしました年度内合格発表の繰上げについては、これは医療機関への雇用等の関係、また、先生御指摘のように、受験者のその準備といったような観点から、可能な限り年度内ということで実施をし",
   "url": "https://kokkai.ndl.go.jp/txt/122114260X01820260714/39"
  },
  {
   "date": "2026-07-14",
   "house": "参議院",
   "meeting": "厚生労働委員会",
   "speaker": "郡山りょう",
   "group": "立憲民主・無所属",
   "chars": 359,
   "excerpt": "○郡山りょう君 ありがとうございます。そこも含めてどうやったら早期化できるのかという、考える検討の余地もあるのではないかと思っておりますので、お願いしたいなと思います。 司法試験では、ＣＢＴ方式の導入が進められていると承知をしています。医師",
   "url": "https://kokkai.ndl.go.jp/txt/122114260X01820260714/40"
  },
  {
   "date": "2026-07-14",
   "house": "参議院",
   "meeting": "厚生労働委員会",
   "speaker": "森光敬子",
   "group": "政府・不明",
   "chars": 882,
   "excerpt": "○政府参考人（森光敬子君） お答え申し上げます。 まず、医師国家試験のＣＢＴ化につきましてでございますが、医師国家試験の在り方については、おおむね五年ごとに医道審議会医師分科会医師国家試験等改善検討会で検討しております。本年二月から新しくこ",
   "url": "https://kokkai.ndl.go.jp/txt/122114260X01820260714/41"
  },
  {
   "date": "2026-07-14",
   "house": "参議院",
   "meeting": "厚生労働委員会",
   "speaker": "郡山りょう",
   "group": "立憲民主・無所属",
   "chars": 1093,
   "excerpt": "○郡山りょう君 ありがとうございます。 なかなか難しいところがあるのは承知しているんですが、ただ、国交省も引っ越し時期の分散の協力も呼びかけているので、やはり費用が高くなって、やっぱりこれ個人負担が大きいと思うんですよね。病院も当然そういっ",
   "url": "https://kokkai.ndl.go.jp/txt/122114260X01820260714/42"
  }
 ],
